{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultThinkingLevel": "high",
  "compaction": {
    "enabled": true
  },
  "enableInstallTelemetry": false,
  "terminal": {
    "showTerminalProgress": true
  },
  "packages": [
    "npm:pi-subagents",
    "npm:pi-sandbox",
    "npm:@marckrenn/pi-sub-bar",
    "npm:pi-web-access"
  ],
  "quietStartup": true,
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5"
}